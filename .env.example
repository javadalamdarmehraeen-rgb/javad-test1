# کپی به .env روی سیستم خودتان — فایل .env وارد Git نمی‌شود
NODE_ENV=production
# fullstack = Render با server.js | static = خروجی نت‌افراز
PLATFORM=fullstack
# آدرس API زنده (معمولاً Render). روی هاست استاتیک حتماً پر شود.
BASE_URL=https://javad-test1.onrender.com
# هاب‌های همگام، با ویرگول. دامنه جدید را همین‌جا اضافه کنید.
CRM_HUBS=https://javad-test1.onrender.com,https://ndcohub.ir,https://mehraeinpharma.ir
# اختیاری
PUBLIC_BASE_URL=
# PORT فقط برای Render / اجرای محلی
PORT=10000
